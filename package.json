{
  "name": "easey-ide",
  "version": "1.3.0",
  "private": true,
  "description": "Easey IDE: l'IDE per imparare a programmare in HTML, CSS, JavaScript, TypeScript e SQL, con progettazione visuale, esercizi verificati e AI locale",
  "author": {
    "name": "Daniele Gabrovec"
  },
  "license": "MIT",
  "homepage": "https://github.com/danielegabrovec/easey-ide",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielegabrovec/easey-ide.git"
  },
  "bugs": {
    "url": "https://github.com/danielegabrovec/easey-ide/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "predev": "npm run ensure:electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/ai.mjs && node tests/e2e/sql.mjs && node tests/e2e/designer.mjs && node tests/e2e/visual.mjs && node tests/e2e/diagrams.mjs && node tests/e2e/learn.mjs && node tests/e2e/growth.mjs && node tests/e2e/quick.mjs && node tests/e2e/quick-native.mjs && node tests/e2e/shell.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "predist": "npm run ensure:electron",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "predist:dir": "npm run ensure:electron",
    "dist:dir": "npm run build && electron-builder --win dir --publish never",
    "test:e2e:smoke": "node tests/e2e/smoke.mjs",
    "test:e2e:ai": "node tests/e2e/ai.mjs",
    "test:e2e:sql": "node tests/e2e/sql.mjs",
    "test:e2e:designer": "node tests/e2e/designer.mjs",
    "test:e2e:visual": "node tests/e2e/visual.mjs",
    "test:e2e:diagrams": "node tests/e2e/diagrams.mjs",
    "test:e2e:learn": "node tests/e2e/learn.mjs",
    "test:e2e:growth": "node tests/e2e/growth.mjs",
    "test:e2e:quick": "node tests/e2e/quick.mjs && node tests/e2e/quick-native.mjs",
    "test:e2e:shell": "node tests/e2e/shell.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@lydell/node-pty": "^1.1.0",
    "esbuild": "^0.25.5",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.12.1",
    "blockly": "^13.4.0",
    "dockview": "^4.4.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "html-to-image": "^1.11.13",
    "jsdom": "^30.1.3",
    "lucide-react": "^0.511.0",
    "monaco-editor": "^0.52.2",
    "node-sql-parser": "^5.4.0",
    "parse5": "^8.1.1",
    "playwright-core": "1.52.0",
    "postcss": "^8.5.32",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "build": {
    "appId": "it.gabrovec.easey-ide",
    "productName": "Easey IDE",
    "copyright": "Copyright © 2026 Daniele Gabrovec",
    "asar": true,
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/esbuild/**",
      "node_modules/@esbuild/**",
      "node_modules/@electric-sql/**",
      "node_modules/pyodide/**",
      "out/main/quick-worker.mjs",
      "out/main/quick-python-worker.mjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Easey-IDE-Setup-${version}.${ext}",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Easey IDE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "language": "1040",
      "deleteAppDataOnUninstall": false,
      "unicode": true
    },
    "npmRebuild": false
  }
}
